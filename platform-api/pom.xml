<?xml version="1.0" encoding="UTF-8"?>
<!--
  AgentForge 平台服务（Java 部分）的 Maven 构建文件。

  设计约定：
    1. 继承 spring-boot-starter-parent：由它统一管理 Spring / Flyway / 驱动等依赖版本，
       因此下面的依赖基本都不写 <version>，避免自己维护一套版本号矩阵。
    2. Flyway 由 Spring Boot 自动配置：只要 classpath 上有 flyway-core（MySQL 还需要
       flyway-mysql）+ DataSource + spring.flyway.* 配置，应用启动时就会扫描
       classpath:db/migration 并执行未执行过的迁移脚本。
    3. 表结构的唯一来源是 Flyway 迁移脚本（src/main/resources/db/migration/），
       因此 JPA 的 ddl-auto 设为 validate，绝不让 Hibernate 去建表/改表。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <!-- 空 relativePath：父 POM 从 Maven 仓库解析，不在本仓库上层找 -->
        <relativePath/>
    </parent>

    <groupId>com.agentforge</groupId>
    <artifactId>platform-api</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>platform-api</name>
    <description>AgentForge 平台服务：项目/会话/消息/文档等业务元数据的 HTTP 接口</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <!-- Web 层：内嵌 Tomcat + Spring MVC，后续业务接口的载体 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 数据访问层：Spring Data JPA + Hibernate（事务、Repository） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- 参数校验：@Valid / @NotNull 等，接口层校验用 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 运维端点：提供 /actuator/health，用于确认服务与数据库是否就绪 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- MySQL 驱动：只在运行时需要，版本由 Spring Boot 统一管理 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway：数据库迁移（建表脚本由它执行），版本同样由 Spring Boot 管理 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- MySQL 8.x 的方言/支持代码在 Spring Boot 3 + Flyway 10+ 里被拆成独立模块，必须显式引入 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- 测试：JUnit 5 + AssertJ + Mockito + spring-test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 让 mvn spring-boot:run / mvn package 产出可直接 java -jar 启动的胖包 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
